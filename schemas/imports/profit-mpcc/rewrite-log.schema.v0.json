{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/rewrite-log.schema.json",
  "title": "RewriteLog",
  "type": "object",
  "required": ["rewrite_log_id", "source_branch_ref", "target_branch_ref", "rewrite_kind", "entries", "created_at"],
  "properties": {
    "rewrite_log_id": { "type": "string" },
    "source_branch_ref": { "type": "string" },
    "target_branch_ref": { "type": "string" },
    "base_context_ref": { "type": "string" },
    "rewrite_kind": {
      "type": "string",
      "enum": ["rebase", "reinterpret", "policy_rewrite", "schema_rewrite"]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": { "type": "string" },
          "rewritten_ref": { "type": "string" },
          "lossiness": { "type": "string", "enum": ["exact", "lossy", "policy_constrained"] },
          "notes": { "type": "string" }
        },
        "required": ["source_ref", "rewritten_ref", "lossiness"],
        "additionalProperties": true
      }
    },
    "policy_basis": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
