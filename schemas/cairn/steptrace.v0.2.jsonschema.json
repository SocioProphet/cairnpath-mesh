{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/cairn/steptrace.v0.2.jsonschema.json",
  "title": "Cairn.StepTrace v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_version",
    "run_id",
    "hop_index",
    "step_id",
    "policy_id",
    "seed",
    "adapter_id",
    "frontier_in_count",
    "frontier_in_ids_hash",
    "state_in_count",
    "state_budget_max",
    "frontier_cap_in",
    "seen_set_update_mode",
    "materialization_mode_in",
    "optional_mode",
    "backend_calls",
    "backend_time_ms",
    "generated_count",
    "unique_count",
    "dedup_ratio",
    "duplication_factor",
    "fanout_effective",
    "seen_global_count_in",
    "new_global_count",
    "novelty_uniq",
    "novelty_gen",
    "novelty_low_streak_in",
    "novelty_low_streak_out",
    "ranking_model_id",
    "ranking_weights_hash",
    "tie_break_rule_id",
    "retained_count",
    "frontier_cap_out",
    "frontier_out_ids_hash",
    "state_out_count",
    "state_trim_applied",
    "empty_attached_count",
    "materialization_mode_out",
    "path_evidence_enabled",
    "path_evidence_updates",
    "mu_gate_triggered",
    "path_evidence_forced_off",
    "policy_override_path_evidence",
    "budget_ops_used_total",
    "budget_ops_remaining",
    "budget_decision_mode",
    "stop_flag",
    "stop_reason",
    "actions"
  ],
  "properties": {
    "trace_version": { "const": "0.2" },
    "run_id": { "type": "string", "minLength": 1 },
    "hop_index": { "type": "integer", "minimum": 0 },
    "step_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "seed": { "type": ["string", "integer" ] },
    "adapter_id": { "type": "string", "minLength": 1 },
    "backend_id": { "type": "string" },

    "frontier_in_count": { "type": "integer", "minimum": 0 },
    "frontier_in_ids_hash": { "$ref": "#/$defs/sha256" },
    "state_in_count": { "type": "integer", "minimum": 0 },
    "state_budget_max": { "type": "integer", "minimum": 1 },
    "frontier_cap_in": { "type": "integer", "minimum": 0 },
    "seen_set_update_mode": { "type": "string", "enum": ["dedup_all", "retained_only", "two_tier"] },
    "seen_window_W": { "type": "integer", "minimum": 0 },
    "materialization_mode_in": { "type": "string", "enum": ["node_only", "path_evidence"] },
    "path_evidence_m": { "type": "integer", "minimum": 0 },
    "optional_mode": { "type": "string", "enum": ["none", "keep_frontier", "attach_empty", "branch_state"] },
    "optional_slot": { "type": "string" },
    "filters_pushed_down": { "type": "array", "items": { "type": "string" } },
    "filters_driver_only": { "type": "array", "items": { "type": "string" } },

    "backend_calls": { "type": "integer", "minimum": 0 },
    "backend_time_ms": { "type": "number", "minimum": 0 },
    "backend_bytes_in": { "type": ["integer", "null"], "minimum": 0 },
    "backend_bytes_out": { "type": ["integer", "null"], "minimum": 0 },
    "backend_plan_fingerprint": { "type": ["string", "null"] },

    "generated_count": { "type": "integer", "minimum": 0 },
    "unique_count": { "type": "integer", "minimum": 0 },
    "dedup_ratio": { "type": "number", "minimum": 0 },
    "duplication_factor": { "type": "number", "minimum": 0 },
    "fanout_effective": { "type": "number", "minimum": 0 },

    "seen_global_count_in": { "type": "integer", "minimum": 0 },
    "seen_window_count_in": { "type": "integer", "minimum": 0 },
    "new_global_count": { "type": "integer", "minimum": 0 },
    "novelty_uniq": { "type": "number", "minimum": 0 },
    "novelty_gen": { "type": "number", "minimum": 0 },
    "novelty_low_streak_in": { "type": "integer", "minimum": 0 },
    "novelty_low_streak_out": { "type": "integer", "minimum": 0 },

    "ranking_model_id": { "type": "string", "minLength": 1 },
    "ranking_weights_hash": { "$ref": "#/$defs/sha256" },
    "tie_break_rule_id": { "type": "string", "minLength": 1 },
    "retained_count": { "type": "integer", "minimum": 0 },
    "frontier_cap_out": { "type": "integer", "minimum": 0 },
    "frontier_out_ids_hash": { "$ref": "#/$defs/sha256" },
    "score_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number" },
        "median": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "diversity_gate_applied": { "type": "boolean" },
    "diversity_buckets_summary": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },

    "state_out_count": { "type": "integer", "minimum": 0 },
    "state_trim_applied": { "type": "boolean" },
    "state_trim_reason": { "type": ["string", "null"] },
    "state_trim_kept": { "type": ["integer", "null"], "minimum": 0 },
    "state_trim_dropped": { "type": ["integer", "null"], "minimum": 0 },
    "empty_attached_count": { "type": "integer", "minimum": 0 },

    "materialization_mode_out": { "type": "string", "enum": ["node_only", "path_evidence"] },
    "path_evidence_enabled": { "type": "boolean" },
    "path_evidence_updates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["best_parent_links_written", "alt_parent_links_written", "evidence_nodes_touched"],
      "properties": {
        "best_parent_links_written": { "type": "integer", "minimum": 0 },
        "alt_parent_links_written": { "type": "integer", "minimum": 0 },
        "evidence_nodes_touched": { "type": "integer", "minimum": 0 }
      }
    },
    "mu_gate_triggered": { "type": "boolean" },
    "path_evidence_forced_off": { "type": "boolean" },
    "policy_override_path_evidence": { "type": "boolean" },

    "budget_ops_used_total": { "type": "integer", "minimum": 0 },
    "budget_ops_remaining": { "type": "integer", "minimum": 0 },
    "budget_mem_est_bytes_total": { "type": ["integer", "null"], "minimum": 0 },
    "budget_mem_remaining_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "budget_io_est_total": { "type": ["integer", "null"], "minimum": 0 },
    "budget_io_remaining": { "type": ["integer", "null"], "minimum": 0 },
    "budget_decision_mode": { "type": "string", "enum": ["measured", "projected", "hybrid"] },
    "projected_next_generated": { "type": ["integer", "null"], "minimum": 0 },
    "stop_flag": { "type": "boolean" },
    "stop_reason": { "type": "string", "enum": ["none", "early_stop_low_novelty", "stop_budget_exceeded", "stop_budget_projected", "stop_backend_timeout", "stop_policy_violation", "stop_user_cancelled"] },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "action_params", "action_trigger_metrics"],
      "properties": {
        "action_type": { "type": "string", "enum": ["cap_shrink", "cap_grow", "force_node_only", "state_trim", "optional_mode_coercion", "projected_stop", "measured_stop", "early_stop_low_novelty", "pivot_suggested", "pushdown_changed", "stop"] },
        "action_params": { "type": "object" },
        "action_trigger_metrics": { "type": "object" }
      }
    }
  }
}
