{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/cairn/entity_ref.v1.jsonschema.json",
  "title": "Cairn.EntityRef v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "namespace", "entity_type"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["business_key", "engine_local_snapshot"]
    },
    "namespace": { "type": "string", "minLength": 1 },
    "entity_type": { "type": "string", "minLength": 1 },
    "key_props": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    },
    "engine": {
      "type": "string",
      "enum": ["neo4j", "atomspace", "terminusdb", "rdf", "custom"]
    },
    "engine_id": { "type": "string", "minLength": 1 },
    "engine_ref": { "type": "string" },
    "graph_snapshot_ref": { "type": "string", "minLength": 1 },
    "display_label": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "business_key" } },
        "required": ["kind"]
      },
      "then": { "required": ["key_props"] }
    },
    {
      "if": {
        "properties": { "kind": { "const": "engine_local_snapshot" } },
        "required": ["kind"]
      },
      "then": { "required": ["engine", "engine_id", "graph_snapshot_ref"] }
    }
  ]
}
