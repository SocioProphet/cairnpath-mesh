{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/cairn/event.v1.jsonschema.json",
  "title": "Cairn.Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "line_id", "type", "at", "payload"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "line_id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "enum": ["STACK", "RESTACK", "REPLAY", "DIVERGENCE", "BRANCH", "REBASE"] },
    "at": { "type": "string", "format": "date-time" },
    "target_cairn_id": { "type": "string" },
    "from_cairn_id": { "type": "string" },
    "payload": { "type": "object" },
    "links": { "type": "array", "items": { "type": "object" } }
  }
}
