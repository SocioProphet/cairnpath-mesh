{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/cairn/materialize.v0.jsonschema.json",
  "title": "Cairn.Materialize v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "materialize_id",
    "line_id",
    "step_id",
    "mode",
    "targets",
    "max_bytes",
    "created_at"
  ],
  "properties": {
    "materialize_id": {
      "type": "string",
      "minLength": 1
    },
    "line_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "metadata_only",
        "properties",
        "full_subgraph",
        "packet"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "store_as": {
      "type": "string",
      "enum": [
        "kb_nodes",
        "packet",
        "cache_only"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
