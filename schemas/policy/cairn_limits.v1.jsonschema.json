{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/policy/cairn_limits.v1.jsonschema.json",
  "title": "Policy.CairnLimits v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "default_frontier_cap",
    "max_frontier_cap",
    "max_hops",
    "allowed_opcodes",
    "max_materialize_bytes",
    "max_elapsed_ms"
  ],
  "properties": {
    "policy_id": { "type": "string", "minLength": 1 },
    "default_frontier_cap": { "type": "integer", "minimum": 0 },
    "max_frontier_cap": { "type": "integer", "minimum": 0 },
    "max_hops": { "type": "integer", "minimum": 0 },
    "allowed_opcodes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "max_materialize_bytes": { "type": "integer", "minimum": 0 },
    "max_elapsed_ms": { "type": "integer", "minimum": 0 },
    "allowed_relations": { "type": "array", "items": { "type": "string" } },
    "allowed_predicates": { "type": "array", "items": { "type": "string" } },
    "allowed_namespaces": { "type": "array", "items": { "type": "string" } },
    "uniqueness_modes": { "type": "array", "items": { "type": "string" } },
    "allowed_identity_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["business_key", "engine_local_snapshot"]
      }
    },
    "require_snapshot_for_engine_ids": { "type": "boolean", "default": true },
    "canonicalization_profile": {
      "type": "string",
      "enum": ["jcs.rfc8785"]
    },
    "set_ref_profile": {
      "type": "string",
      "enum": ["sha256.v1", "merkle-sha256.v1", "mixed.v1"]
    },
    "allow_unsafe_unbounded": { "type": "boolean", "default": false }
  }
}
