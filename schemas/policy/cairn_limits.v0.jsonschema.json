{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.org/schemas/policy/cairn_limits.v0.jsonschema.json",
  "title": "Policy.CairnLimits v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "default_cap_k",
    "max_cap_k",
    "max_hops",
    "allowed_opcodes",
    "max_materialize_bytes",
    "max_elapsed_ms"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "default_cap_k": {
      "type": "integer",
      "minimum": 0
    },
    "max_cap_k": {
      "type": "integer",
      "minimum": 0
    },
    "max_hops": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_opcodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "max_materialize_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "max_elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_relations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_predicates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uniqueness_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
